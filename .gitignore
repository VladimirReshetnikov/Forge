# ---------------------------------------------------------------------------
# LaTeX build products
#
# article/forge.pdf and proposals/*/article/*.pdf are tracked deliberately:
# the rendered articles are part of the deliverable. Everything a LaTeX run
# regenerates is not.
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.glo
*.gls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv
*.dvi

# LaTeX logs only -- results/*.log are recorded evidence and stay tracked.
article/**/*.log
proposals/*/article/**/*.log

# ---------------------------------------------------------------------------
# Lean / Lake
# ---------------------------------------------------------------------------
.lake/
lake-packages/
lean/build/
*.olean
*.ilean
*.trace
*.hash
lakefile.olean

# ---------------------------------------------------------------------------
# Reproduction output
#
# results/ holds the recorded evidence of the original runs and is tracked.
# Re-running an experiment should write to a separate directory so the
# recorded run stays intact; those directories are ignored.
# ---------------------------------------------------------------------------
reproduced-results/
local-lean-results.json
lean-benchmark.json
scratch/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
