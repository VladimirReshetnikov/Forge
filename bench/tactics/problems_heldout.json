{
  "what": "A HELD-OUT set of integer polynomial inequalities, for testing whether the search fixes generalise.",
  "protocol": "Written after the search fixes that were made in response to bench/tactics/problems.json, and committed and pushed BEFORE any tool was run on it, so the git history fixes it before its results existed. The search is not to be changed in response to these results; if it ever is, a further held-out set is needed and this one stops counting as held out.",
  "not": "A curated set, not a published suite. Chosen to differ from the first set: new shapes (products of hypotheses, powers of a single hypothesis, an equality with a nonlinear multiplier, six variables), not variations tuned to what the fixes handle.",
  "problems": [
    {"id": "cauchy_schwarz3", "name": "Cauchy-Schwarz in three dimensions (6 variables, degree 4)",
     "vars": ["a", "b", "c", "x", "y", "z"], "hyps": [],
     "goal": "(a * x + b * y + c * z) ^ 2 ≤ (a ^ 2 + b ^ 2 + c ^ 2) * (x ^ 2 + y ^ 2 + z ^ 2)"},
    {"id": "two_fourth_powers", "name": "x^4 + y^4 >= 2 x^2 y^2",
     "vars": ["x", "y"], "hyps": [], "goal": "2 * (x ^ 2 * y ^ 2) ≤ x ^ 4 + y ^ 4"},
    {"id": "sq_plus_one", "name": "x^2 + y^2 + 1 >= xy + x + y",
     "vars": ["x", "y"], "hyps": [], "goal": "x * y + x + y ≤ x ^ 2 + y ^ 2 + 1"},
    {"id": "sum_sq_bound3", "name": "(x+y+z)^2 <= 3(x^2+y^2+z^2)",
     "vars": ["x", "y", "z"], "hyps": [], "goal": "(x + y + z) ^ 2 ≤ 3 * (x ^ 2 + y ^ 2 + z ^ 2)"},
    {"id": "four_squares_cross", "name": "a^2+b^2+c^2+d^2 >= a(b+c+d)",
     "vars": ["a", "b", "c", "d"], "hyps": [], "goal": "a * (b + c + d) ≤ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2"},
    {"id": "sextic_two_var", "name": "x^6 + y^6 >= x^4 y^2 + x^2 y^4 (degree 6)",
     "vars": ["x", "y"], "hyps": [], "goal": "x ^ 4 * y ^ 2 + x ^ 2 * y ^ 4 ≤ x ^ 6 + y ^ 6"},
    {"id": "univariate_square", "name": "4x^4 - 4x^3 + x^2 >= 0, a square of 2x^2 - x",
     "vars": ["x"], "hyps": [], "goal": "0 ≤ 4 * x ^ 4 - 4 * x ^ 3 + x ^ 2"},
    {"id": "univariate_quartic", "name": "x^4 - 2x^3 + 3x^2 - 2x + 1 >= 0, a square of x^2 - x + 1",
     "vars": ["x"], "hyps": [], "goal": "0 ≤ x ^ 4 - 2 * x ^ 3 + 3 * x ^ 2 - 2 * x + 1"},
    {"id": "cube_of_sum", "name": "(a+b)^3 >= a^3 + b^3 for a, b >= 0",
     "vars": ["a", "b"], "hyps": [["ha", "0 ≤ a"], ["hb", "0 ≤ b"]],
     "goal": "a ^ 3 + b ^ 3 ≤ (a + b) ^ 3"},
    {"id": "unit_interval", "name": "x^2 <= x for 0 <= x <= 1",
     "vars": ["x"], "hyps": [["h0", "0 ≤ x"], ["h1", "x ≤ 1"]], "goal": "x ^ 2 ≤ x"},
    {"id": "cube_above_one", "name": "x^3 >= x for x >= 1",
     "vars": ["x"], "hyps": [["h", "1 ≤ x"]], "goal": "x ≤ x ^ 3"},
    {"id": "sum_one_squares", "name": "x + y = 1 implies 2(x^2 + y^2) >= 1",
     "vars": ["x", "y"], "hyps": [["h", "x + y = 1"]], "goal": "1 ≤ 2 * (x ^ 2 + y ^ 2)"},
    {"id": "product_one", "name": "xy = 1 implies x^2 + y^2 >= 2",
     "vars": ["x", "y"], "hyps": [["h", "x * y = 1"]], "goal": "2 ≤ x ^ 2 + y ^ 2"},
    {"id": "pairwise_products", "name": "a^2b^2 + b^2c^2 + c^2a^2 >= abc(a+b+c)",
     "vars": ["a", "b", "c"], "hyps": [],
     "goal": "a * b * c * (a + b + c) ≤ a ^ 2 * b ^ 2 + b ^ 2 * c ^ 2 + c ^ 2 * a ^ 2"},
    {"id": "square_of_sum_of_squares", "name": "(x^2 + y^2)^2 >= 4x^2y^2",
     "vars": ["x", "y"], "hyps": [], "goal": "4 * (x ^ 2 * y ^ 2) ≤ (x ^ 2 + y ^ 2) ^ 2"},
    {"id": "amgm4_shifted", "name": "x^4 + y^4 + 8 >= 8xy",
     "vars": ["x", "y"], "hyps": [], "goal": "8 * (x * y) ≤ x ^ 4 + y ^ 4 + 8"},
    {"id": "amgm3_nonneg", "name": "x^3 + y^3 + z^3 >= 3xyz for x, y, z >= 0",
     "vars": ["x", "y", "z"], "hyps": [["hx", "0 ≤ x"], ["hy", "0 ≤ y"], ["hz", "0 ≤ z"]],
     "goal": "3 * (x * y * z) ≤ x ^ 3 + y ^ 3 + z ^ 3"},
    {"id": "shifted_three", "name": "x^2 + y^2 + z^2 + 3 >= 2(x + y + z)",
     "vars": ["x", "y", "z"], "hyps": [], "goal": "2 * (x + y + z) ≤ x ^ 2 + y ^ 2 + z ^ 2 + 3"},
    {"id": "weighted_quadratic", "name": "a positive definite quadratic form with unequal weights",
     "vars": ["x", "y"], "hyps": [], "goal": "0 ≤ 5 * x ^ 2 - 4 * (x * y) + 2 * y ^ 2"},
    {"id": "choi_lam", "name": "Choi-Lam S(x,y,z) (nonnegative, NOT a sum of squares, degree 6)",
     "vars": ["x", "y", "z"], "hyps": [],
     "goal": "0 ≤ x ^ 4 * y ^ 2 + y ^ 4 * z ^ 2 + z ^ 4 * x ^ 2 - 3 * (x ^ 2 * y ^ 2 * z ^ 2)",
     "probe": "Not a sum of squares: an SOS search should fail here, for the right reason."}
  ]
}
