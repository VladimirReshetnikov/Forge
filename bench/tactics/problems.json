{
  "what": "Polynomial inequalities over Int for a head-to-head between forge_cone? and existing Lean tactics. Each is a well-known inequality or a standard textbook form. NONE was constructed from a Forge certificate: the point is to measure the search on problems it did not choose.",
  "not": "This is a curated set, not a published benchmark suite. It is small, it favours degree <= 4 because the Forge oracle's bounds are degree 4 and 6 variables, and two problems deliberately probe those bounds.",
  "problems": [
    {"id": "amgm2", "name": "AM-GM, two variables",
     "vars": ["x", "y"], "hyps": [], "goal": "2 * (x * y) ≤ x ^ 2 + y ^ 2"},
    {"id": "one_plus_sq", "name": "1 + x^2 >= 2x",
     "vars": ["x"], "hyps": [], "goal": "2 * x ≤ 1 + x ^ 2"},
    {"id": "sq_sum_cross3", "name": "x^2+y^2+z^2 >= xy+yz+zx",
     "vars": ["x", "y", "z"], "hyps": [], "goal": "x * y + y * z + z * x ≤ x ^ 2 + y ^ 2 + z ^ 2"},
    {"id": "sum_sq_bound", "name": "(x+y)^2 <= 2(x^2+y^2)",
     "vars": ["x", "y"], "hyps": [], "goal": "(x + y) ^ 2 ≤ 2 * (x ^ 2 + y ^ 2)"},
    {"id": "quad_form_pd", "name": "x^2 - xy + y^2 >= 0",
     "vars": ["x", "y"], "hyps": [], "goal": "0 ≤ x ^ 2 - x * y + y ^ 2"},
    {"id": "shifted_squares", "name": "(x-1)^2+(y-1)^2 >= 0 in expanded form",
     "vars": ["x", "y"], "hyps": [], "goal": "2 * x + 2 * y - 2 ≤ x ^ 2 + y ^ 2"},
    {"id": "tridiagonal3", "name": "positive semidefinite tridiagonal quadratic form",
     "vars": ["x", "y", "z"], "hyps": [], "goal": "0 ≤ 2 * x ^ 2 + 2 * y ^ 2 + 2 * z ^ 2 - 2 * (x * y) - 2 * (y * z)"},
    {"id": "cauchy_schwarz2", "name": "Cauchy-Schwarz in two dimensions",
     "vars": ["a", "b", "c", "d"], "hyps": [], "goal": "(a * c + b * d) ^ 2 ≤ (a ^ 2 + b ^ 2) * (c ^ 2 + d ^ 2)"},
    {"id": "quartic_2", "name": "a^4 + b^4 >= a^3 b + a b^3",
     "vars": ["a", "b"], "hyps": [], "goal": "a ^ 3 * b + a * b ^ 3 ≤ a ^ 4 + b ^ 4"},
    {"id": "fourth_power", "name": "(x-y)^4 >= 0 in expanded form",
     "vars": ["x", "y"], "hyps": [], "goal": "0 ≤ x ^ 4 - 4 * x ^ 3 * y + 6 * x ^ 2 * y ^ 2 - 4 * x * y ^ 3 + y ^ 4"},
    {"id": "quartic_sq_sum3", "name": "x^4+y^4+z^4 >= x^2y^2+y^2z^2+z^2x^2",
     "vars": ["x", "y", "z"], "hyps": [], "goal": "x ^ 2 * y ^ 2 + y ^ 2 * z ^ 2 + z ^ 2 * x ^ 2 ≤ x ^ 4 + y ^ 4 + z ^ 4"},
    {"id": "quartic_abc", "name": "a^4+b^4+c^4 >= abc(a+b+c)",
     "vars": ["a", "b", "c"], "hyps": [], "goal": "a * b * c * (a + b + c) ≤ a ^ 4 + b ^ 4 + c ^ 4"},
    {"id": "nonneg_cubic", "name": "x^3 + y^3 >= x^2 y + x y^2 for x, y >= 0",
     "vars": ["x", "y"], "hyps": [["hx", "0 ≤ x"], ["hy", "0 ≤ y"]],
     "goal": "x ^ 2 * y + x * y ^ 2 ≤ x ^ 3 + y ^ 3"},
    {"id": "guard_product", "name": "(x-1)(y-1) >= 0 for x, y >= 1",
     "vars": ["x", "y"], "hyps": [["hx", "1 ≤ x"], ["hy", "1 ≤ y"]],
     "goal": "x + y - 1 ≤ x * y"},
    {"id": "sum_fixed_product", "name": "x + y = 2 implies xy <= 1",
     "vars": ["x", "y"], "hyps": [["h", "x + y = 2"]], "goal": "x * y ≤ 1"},
    {"id": "sum_fixed_squares3", "name": "x + y + z = 3 implies x^2+y^2+z^2 >= 3",
     "vars": ["x", "y", "z"], "hyps": [["h", "x + y + z = 3"]], "goal": "3 ≤ x ^ 2 + y ^ 2 + z ^ 2"},
    {"id": "schur_t1", "name": "Schur's inequality, t = 1, nonnegative variables",
     "vars": ["x", "y", "z"], "hyps": [["hx", "0 ≤ x"], ["hy", "0 ≤ y"], ["hz", "0 ≤ z"]],
     "goal": "0 ≤ x * (x - y) * (x - z) + y * (y - x) * (y - z) + z * (z - x) * (z - y)"},
    {"id": "product_of_nonneg3", "name": "xyz >= 0 for x, y, z >= 0",
     "vars": ["x", "y", "z"], "hyps": [["hx", "0 ≤ x"], ["hy", "0 ≤ y"], ["hz", "0 ≤ z"]],
     "goal": "0 ≤ x * y * z"},
    {"id": "motzkin", "name": "Motzkin polynomial (nonnegative, NOT a sum of squares, degree 6)",
     "vars": ["x", "y"], "hyps": [],
     "goal": "0 ≤ x ^ 4 * y ^ 2 + x ^ 2 * y ^ 4 - 3 * (x ^ 2 * y ^ 2) + 1",
     "probe": "Not SOS, and degree 6 exceeds the oracle's degree bound: Forge should fail."},
    {"id": "sextic_sos", "name": "(x^3 - y^3)^2 >= 0 expanded, degree 6",
     "vars": ["x", "y"], "hyps": [],
     "goal": "2 * (x ^ 3 * y ^ 3) ≤ x ^ 6 + y ^ 6",
     "probe": "SOS but degree 6: probes the oracle's degree bound rather than its search."}
  ]
}
