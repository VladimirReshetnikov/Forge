    {"id": "lin_infeasible", "class": "linear", "statement": "(x : Int) (h1 : 2 * x ≥ 5) (h2 : 2 * x ≤ 5) : False", "expected_worker": "omega"},
    {"id": "eq_congr", "class": "equational", "statement": "(f : Nat → Nat) (a b : Nat) (h : a = b) : f a = f b", "expected_worker": "grind"},
    {"id": "eq_trans_fun", "class": "equational", "statement": "(f g : Nat → Nat) (a : Nat) (h1 : f a = g a) (h2 : g a = 3) : f a = 3", "expected_worker": "grind"},
    {"id": "prop_and_comm", "class": "propositional", "statement": "(p q : Prop) (h : p ∧ q) : q ∧ p", "expected_worker": "grind"},
