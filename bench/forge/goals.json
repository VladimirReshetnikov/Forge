    {"id": "induction_sum", "class": "out_of_reach", "statement": "(n : Nat) : 2 * (List.range (n + 1)).sum = n * (n + 1)", "expected_worker": "none"},
    {"id": "induction_rev_append", "class": "out_of_reach", "statement": "(xs ys : List Nat) : (xs ++ ys).reverse = ys.reverse ++ xs.reverse", "expected_worker": "grind (simp lemma exists)"},
    {"id": "exists_witness", "class": "out_of_reach", "statement": "(n : Nat) : ∃ m, m > n ∧ m % 2 = 0", "expected_worker": "none"}
  ]
