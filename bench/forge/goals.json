{
  "what": "Goals for the forge baseline suite that are NOT nonlinear inequalities: closed arithmetic, linear arithmetic, propositional and equational reasoning, simple data. Core Lean only. Together with bench/tactics/problems.json and problems_heldout.json (40 nonlinear Int inequalities) they form the suite tools/forge_baseline.py runs.",
  "expected_worker": "The worker the author EXPECTED to close each goal, written before any run. It is a prediction, recorded so the run can contradict it, and is never used to decide a result.",
  "true_by": "Every statement is a true theorem of core Lean. The out_of_reach goals are true but were chosen so that, as far as the author knew, no worker in forge's list closes them.",
  "goals": [
    {"id": "closed_add", "class": "closed", "statement": ": (2 : Nat) + 2 = 4", "expected_worker": "decide"},
    {"id": "closed_mul_lt", "class": "closed", "statement": ": (7 : Nat) * 8 < 57", "expected_worker": "decide"},
    {"id": "closed_mod", "class": "closed", "statement": ": (1000 : Nat) % 7 = 6", "expected_worker": "decide"},
    {"id": "closed_bool", "class": "closed", "statement": ": (true && !false) = true", "expected_worker": "decide"},
    {"id": "closed_list_len", "class": "closed", "statement": ": ([1, 2, 3] : List Nat).length = 3", "expected_worker": "decide"},
    {"id": "closed_int_neg", "class": "closed", "statement": ": (-3 : Int) * 4 + 12 = 0", "expected_worker": "decide"},
    {"id": "closed_fin_all", "class": "closed", "statement": ": ∀ i : Fin 5, i.val < 5", "expected_worker": "decide"},
    {"id": "closed_nat_bounded", "class": "closed", "statement": ": ∀ n, n < 10 → n * n < 100", "expected_worker": "decide"},
    {"id": "lin_succ_le", "class": "linear", "statement": "(x y : Nat) (h : x < y) : x + 1 ≤ y", "expected_worker": "omega"},
    {"id": "lin_int_chain", "class": "linear", "statement": "(a b c : Int) (h1 : a ≤ b) (h2 : b < c) : a < c", "expected_worker": "omega"},
    {"id": "lin_sub_nat", "class": "linear", "statement": "(n m : Nat) (h : m ≤ n) : n - m + m = n", "expected_worker": "omega"},
    {"id": "lin_div_mod", "class": "linear", "statement": "(n : Nat) : n % 2 = 0 ∨ n % 2 = 1", "expected_worker": "omega"},
    {"id": "lin_three_var", "class": "linear", "statement": "(x y z : Int) (h1 : 2 * x + 3 * y ≤ 6) (h2 : x ≥ 0) (h3 : y ≥ 0) (h4 : z = x + y) : z ≤ 3", "expected_worker": "omega"},
    {"id": "lin_parity", "class": "linear", "statement": "(n : Nat) (h : n % 4 = 3) : n % 2 = 1", "expected_worker": "omega"},
