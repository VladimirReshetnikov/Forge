    {"id": "eq_list_cons", "class": "equational", "statement": "(x y : Nat) (xs ys : List Nat) (h : x :: xs = y :: ys) : xs = ys", "expected_worker": "grind"},
    {"id": "mixed_fun_linear", "class": "mixed", "statement": "(f : Nat → Nat) (a b : Nat) (h1 : a = b + 1) (h2 : f (b + 1) = 10) : f a + 1 = 11", "expected_worker": "grind"},
    {"id": "mixed_ite", "class": "mixed", "statement": "(x : Nat) : (if x < 5 then x else 5) ≤ 5", "expected_worker": "grind"},
